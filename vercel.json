{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/feed",
      "destination": "/feed.html"
    },
    {
      "source": "/profile",
      "destination": "/profile.html"
    },
    {
      "source": "/user-profile",
      "destination": "/user-profile.html"
    },
    {
      "source": "/user",
      "destination": "/user-profile.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/",
      "destination": "/login.html"
    }
  ]
}
